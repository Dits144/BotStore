# Database connection (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ditsstore_ai?schema=public"

# Supabase Credentials (optional, for realtime & auth sync)
NEXT_PUBLIC_SUPABASE_URL="https://your-supabase-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Provider API Keys
GEMINI_API_KEY=""

# Application URL
APP_URL="http://localhost:3000"

# WhatsApp Session Secret
WHATSAPP_SESSION_SECRET="super-secret-key-ditsstore"

# JWT Secret for Admin Auth
JWT_SECRET="ditsstore-admin-jwt-secret-key-2026"
